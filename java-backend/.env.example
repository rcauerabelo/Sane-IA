# Porta do servidor HTTP
PORT=8080

# Firebase / Cloud Firestore (mesmo projeto e banco nomeado da prévia SaneIA)
FIREBASE_PROJECT_ID=gen-lang-client-0625814070
FIREBASE_DATABASE_ID=ai-studio-saneia-7a98979b-e267-4f19-8dc1-db7bc22e3868
FIREBASE_CHECK_REVOKED=false
# Caminho para o arquivo JSON da Service Account do Firebase (ou deixe vazio para Application Default Credentials)
FIREBASE_CREDENTIALS_PATH=
# Alternativa em plataformas PaaS: conteúdo JSON inline da Service Account
FIREBASE_CREDENTIALS_JSON=

# API de IA (Groq compatível com OpenAI)
GROQ_API_KEY=
IA_API_URL=https://api.groq.com/openai/v1/chat/completions
IA_API_MODEL=openai/gpt-oss-120b

# Google Maps Platform (Geocodificação e centralização no mapa)
GOOGLE_MAPS_API_KEY=

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
